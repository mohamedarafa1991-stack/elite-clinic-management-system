{
  "name": "@elite/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Elite Clinic Management System Windows desktop and local Hub application.",
  "author": "Elite Clinic Management System",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elite/auth": "workspace:*",
    "@elite/contracts": "workspace:*",
    "@elite/database": "workspace:*",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "43.4.0",
    "vite": "^7.1.3"
  }
}
