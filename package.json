{
  "name": "elite-clinic-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Elite Clinic Management System — local-first Windows and Android clinic software.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @elite/contracts build && pnpm --filter @elite/database build && pnpm --filter @elite/auth build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @elite/auth test:coverage",
    "lint": "pnpm -r lint",
    "format:check": "pnpm exec prettier --check .",
    "format": "pnpm exec prettier --write .",
    "security:check": "pnpm audit --audit-level high",
    "desktop:dev": "pnpm --filter @elite/desktop dev",
    "desktop:build": "pnpm --filter @elite/desktop build",
    "desktop:native-rebuild": "electron-rebuild --force --module-dir apps/desktop",
    "desktop:package:dir": "node scripts/package-desktop.mjs --dir",
    "desktop:package:win": "node scripts/package-desktop.mjs --win",
    "desktop:package:verify": "node scripts/verify-desktop-package.mjs",
    "db:test": "pnpm --filter @elite/database test",
    "contracts:typecheck": "pnpm --filter @elite/contracts typecheck"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/rebuild": "4.2.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "3.2.7",
    "electron-builder": "26.15.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
